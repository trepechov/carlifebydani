# Theme build output
/theme/dist

# Theme dependencies
/theme/node_modules

# Plugin dependencies (future)
/plugins/*/node_modules
/plugins/*/vendor

# Zip archives
*.zip

# Editor configuration
/.vscode
/.idea
/.history

# OS-generated files
.DS_Store
Thumbs.db

# Local-only MCP server runtime (GSC MCP launcher + vendored package).
# Personal/local — registered at local scope in ~/.claude.json, never committed.
/.mcp-local

# Python bytecode
__pycache__/
*.pyc

# Credentials (never commit)
/.credentials

# Local Claude Code settings (personal MCP servers, permissions)
/.claude/settings.local.json
# Test output (generated files, never commit)
/plugins/*/tests/output/
